{
  "manifest_version": 3,
  "name": "Manga Indo Auto Translate",
  "version": "1.1.0",
  "description": "Deteksi dialog manga multi-bahasa dan terjemahkan ke bahasa Indonesia dengan Gemini.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}